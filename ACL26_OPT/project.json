{
  "project_id": "acl26-adi-opt",
  "name": "ACL26 ADI AutoOpt Layer",
  "walkthrough_path": "walkthrough.md",
  "contract_path": "contract.json",
  "task_definition_path": "task_definition.json",
  "runtime": {
    "state_dir": ".autoopt/jobs",
    "artifacts_dir": "artifacts",
    "default_worker": "rule-based",
    "max_turns_per_run": 12,
    "source_conda_env": "AutoOpt",
    "remote_env_export_strategy": "from-history",
    "remote_env_spec_path": "config/remote_environment.yml",
    "install_conda_if_missing": true,
    "remote_conda_installer_url": "https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh"
  },
  "data_plane": {
    "preferred_large_transfer": "rclone_via_tos",
    "tos_remote_name": "objectstore",
    "tos_bucket": "example-autoopt-bucket",
    "tos_prefix": "datasets/autoopt-workspace/ACL26_ADI/Data",
    "eco_target_data_root": "/data/autoopt-workspace/ACL26_ADI/Data",
    "notes": "For large dataset movement toward A100 hosts, prefer rclone -> object storage -> /data rather than rsync/scp."
  },
  "execution_topology": {
    "controller_host": "local-controller",
    "default_local_host": "local-controller",
    "default_compute_hosts": [
      "gpu-worker-01",
      "gpu-worker-02",
      "gpu-worker-03"
    ],
    "routing_profiles": {
      "repo_diagnose": [
        "local-controller"
      ],
      "small_gpu_validate": [
        "local-controller"
      ],
      "evaluation": [
        "local-controller"
      ],
      "gpu_train": [
        "gpu-worker-01",
        "gpu-worker-02",
        "gpu-worker-03"
      ]
    },
    "hosts": {
      "local-controller": {
        "mode": "local",
        "roles": [
          "controller",
          "diagnose",
          "small_gpu_validate",
          "evaluation"
        ],
        "local_aliases": [
          "local-controller",
          "local-controller"
        ],
        "codex_ready": true,
        "small_gpu_ok": true
      },
      "gpu-worker-02": {
        "mode": "dispatch",
        "roles": [
          "gpu_train"
        ],
        "ssh_target": "gpu-worker-02",
        "project_root": "/data/autoopt-workspace/AutoOpt/ACL26_OPT",
        "workspace_root": "/data/autoopt-workspace/AutoOpt",
        "conda_env_name": "AutoOpt",
        "gpu_type": "A100",
        "gpu_count": 8,
        "shared_storage_root": "/data/autoopt-workspace",
        "install_conda_if_missing": true,
        "conda_root": "/root/miniforge3",
        "post_create_commands": [
          "bash /data/autoopt-workspace/AutoOpt/ACL26_OPT/scripts/bootstrap_autoopt_env.sh AutoOpt"
        ],
        "bootstrap": {
          "sync_paths": [
            "autoopt",
            "ACL26_OPT",
            "README.md",
            "pyproject.toml",
            "docs",
            "templates"
          ]
        }
      },
      "gpu-worker-03": {
        "mode": "dispatch",
        "roles": [
          "gpu_train"
        ],
        "ssh_target": "gpu-worker-03",
        "project_root": "/data/autoopt-workspace/AutoOpt/ACL26_OPT",
        "workspace_root": "/data/autoopt-workspace/AutoOpt",
        "conda_env_name": "AutoOpt",
        "gpu_type": "A100",
        "gpu_count": 8,
        "shared_storage_root": "/data/autoopt-workspace",
        "install_conda_if_missing": true,
        "conda_root": "/root/miniforge3",
        "post_create_commands": [
          "bash /data/autoopt-workspace/AutoOpt/ACL26_OPT/scripts/bootstrap_autoopt_env.sh AutoOpt"
        ],
        "bootstrap": {
          "sync_paths": [
            "autoopt",
            "ACL26_OPT",
            "README.md",
            "pyproject.toml",
            "docs",
            "templates"
          ]
        }
      },
      "gpu-worker-01": {
        "mode": "dispatch",
        "roles": [
          "gpu_train"
        ],
        "ssh_target": "gpu-worker-01",
        "project_root": "/data/autoopt-workspace/AutoOpt/ACL26_OPT",
        "workspace_root": "/data/autoopt-workspace/AutoOpt",
        "conda_env_name": "AutoOpt",
        "gpu_type": "A100",
        "gpu_count": 8,
        "shared_storage_root": "/data/autoopt-workspace",
        "install_conda_if_missing": true,
        "conda_root": "/root/miniforge3",
        "post_create_commands": [
          "bash /data/autoopt-workspace/AutoOpt/ACL26_OPT/scripts/bootstrap_autoopt_env.sh AutoOpt"
        ],
        "bootstrap": {
          "sync_paths": [
            "autoopt",
            "ACL26_OPT",
            "README.md",
            "pyproject.toml",
            "docs",
            "templates"
          ]
        }
      }
    }
  },
  "source_project": {
    "name": "ACL26_ADI",
    "linked_source_root": "../ACL26_ADI_source",
    "original_source_root": "/data/autoopt-workspace/ACL26_ADI",
    "acl_root_relative": "ACL",
    "data_root_relative": "Data"
  },
  "tool_registry": {
    "prepare_source_link": {
      "adapter": "data",
      "description": "Create the local source symlink that points to ACL26_ADI and report shared-data staging status.",
      "command": "python3 scripts/prepare_source_link.py --project-root {project_root} --original-source-root /data/autoopt-workspace/ACL26_ADI --link-name ACL26_ADI_source --shared-source-root /data/autoopt-workspace/ACL26_ADI --result-json {result_json}",
      "produces_artifacts": [
        "artifacts/runtime/source_link.json"
      ],
      "budget_cost": 1,
      "workload_profile": "repo_diagnose"
    },
    "diagnose_acl26_adi": {
      "adapter": "data",
      "description": "Inspect ACL26_ADI and summarize the ADI-only adaptation requirements.",
      "command": "python3 scripts/diagnose.py --project-root {project_root} --task-definition-path {project_root}/task_definition.json --source-root /data/autoopt-workspace/ACL26_ADI --acl-root /data/autoopt-workspace/ACL26_ADI/ACL --data-root /data/autoopt-workspace/ACL26_ADI/Data --result-json {result_json}",
      "produces_artifacts": [
        "artifacts/analysis/acl26_adi_diagnosis.json"
      ],
      "budget_cost": 5,
      "workload_profile": "repo_diagnose"
    },
    "audit_data_inventory": {
      "adapter": "data",
      "description": "Audit the Data directory against the 6-region task definition and classify each dataset as whitelist, graylist, or blocked.",
      "command": "python3 scripts/audit_data_inventory.py --project-root {project_root} --task-definition-path {project_root}/task_definition.json --data-root /data/autoopt-workspace/ACL26_ADI/Data --result-json {result_json}",
      "produces_artifacts": [
        "artifacts/analysis/data_inventory_report.json"
      ],
      "budget_cost": 4,
      "workload_profile": "repo_diagnose"
    },
    "verify_runtime": {
      "adapter": "data",
      "description": "Verify that conda AutoOpt contains the packages needed by the ADI wrappers.",
      "command": "python3 scripts/verify_runtime.py --project-root {project_root} --task-definition-path {project_root}/task_definition.json --source-root /data/autoopt-workspace/ACL26_ADI --result-json {result_json}",
      "produces_artifacts": [
        "artifacts/runtime/runtime_report.json"
      ],
      "budget_cost": 2,
      "workload_profile": "repo_diagnose"
    },
    "verify_ecoschool_formal_ready": {
      "adapter": "data",
      "description": "Bootstrap gpu-worker-01 and verify that the formal acoustic-only recipe can see GPUs, tmux, full staged datasets, and object storage access.",
      "command": "python3 scripts/verify_eco_ready.py --project-root {project_root} --source-root /data/autoopt-workspace/ACL26_ADI --data-root /data/autoopt-workspace/ACL26_ADI/Data --recipe acoustic_v1 --rclone-remote objectstore --tos-bucket example-autoopt-bucket --require-tos-access --result-json {result_json}",
      "produces_artifacts": [
        "artifacts/runtime/eco_ready_acoustic_v1.json"
      ],
      "budget_cost": 2,
      "workload_profile": "gpu_train",
      "candidate_hosts": [
        "gpu-worker-01"
      ],
      "dispatch_strategy": "first"
    },
    "train_acl26_acoustic_v1": {
      "adapter": "compute",
      "description": "Run the first serious acoustic-only baseline recipe on gpu-worker-01 using full ADI17 training data and MGB2 MSA augmentation.",
      "command": "python3 scripts/train_acl26.py acoustic_v1 --project-root {project_root} --task-definition-path {project_root}/task_definition.json --source-root /data/autoopt-workspace/ACL26_ADI --acl-root /data/autoopt-workspace/ACL26_ADI/ACL --data-root /data/autoopt-workspace/ACL26_ADI/Data --execution-host {execution_host} --execution-mode {execution_mode} --execution-project-root {execution_project_root} --result-json {result_json}",
      "produces_artifacts": [
        "artifacts/metrics/latest_train.json",
        "artifacts/runtime/train_manifest_acoustic_v1.json"
      ],
      "budget_cost": 60,
      "workload_profile": "gpu_train",
      "candidate_hosts": [
        "gpu-worker-01"
      ],
      "dispatch_strategy": "first"
    },
    "evaluate_acl26_formal_dev": {
      "adapter": "evaluation",
      "description": "Evaluate the current acoustic-only baseline on the frozen formal dev suite.",
      "command": "python3 scripts/evaluate_acl26.py --project-root {project_root} --task-definition-path {project_root}/task_definition.json --source-root /data/autoopt-workspace/ACL26_ADI --acl-root /data/autoopt-workspace/ACL26_ADI/ACL --data-root /data/autoopt-workspace/ACL26_ADI/Data --execution-host {execution_host} --execution-mode {execution_mode} --execution-project-root {execution_project_root} --eval-suite formal_dev --result-json {result_json}",
      "produces_artifacts": [
        "artifacts/metrics/latest_eval.json",
        "artifacts/metrics/eval_formal_dev_acoustic_v1.json",
        "artifacts/metrics/latest_eval_formal_dev_acoustic_v1.json"
      ],
      "budget_cost": 12,
      "workload_profile": "evaluation",
      "metric_scope": "evaluation"
    },
    "evaluate_acl26_local_gold": {
      "adapter": "evaluation",
      "description": "Evaluate the current acoustic-only baseline on the Local gold evaluation suite once mirrored audio is ready on local-controller.",
      "command": "python3 scripts/evaluate_acl26.py --project-root {project_root} --task-definition-path {project_root}/task_definition.json --source-root /data/autoopt-workspace/ACL26_ADI --acl-root /data/autoopt-workspace/ACL26_ADI/ACL --data-root /data/autoopt-workspace/ACL26_ADI/Data --execution-host {execution_host} --execution-mode {execution_mode} --execution-project-root {execution_project_root} --eval-suite local_gold --result-json {result_json}",
      "produces_artifacts": [
        "artifacts/metrics/eval_local_gold.json",
        "artifacts/metrics/latest_eval_local_gold.json",
        "artifacts/metrics/eval_local_gold_acoustic_v1.json",
        "artifacts/metrics/latest_eval_local_gold_acoustic_v1.json"
      ],
      "budget_cost": 12,
      "workload_profile": "evaluation",
      "metric_scope": "evaluation"
    },
    "reflect_acl26_acoustic_v1": {
      "adapter": "evaluation",
      "description": "Summarize what the first serious acoustic-only baseline proved and what still blocks the next optimization step.",
      "command": "python3 scripts/reflect_acl26.py --project-root {project_root} --task-definition-path {project_root}/task_definition.json --result-json {result_json}",
      "produces_artifacts": [
        "artifacts/analysis/reflection_1.json"
      ],
      "budget_cost": 2,
      "workload_profile": "evaluation"
    }
  },
  "decision_rules": [
    {
      "name": "prepare source link first",
      "when": {
        "missing_artifacts": [
          "artifacts/runtime/source_link.json"
        ]
      },
      "phase": "diagnose",
      "tools": [
        "prepare_source_link"
      ],
      "summary": "Create the source-project link before any ADI diagnosis or training wrapper runs.",
      "followup_phase": "diagnose"
    },
    {
      "name": "audit data inventory",
      "when": {
        "missing_artifacts": [
          "artifacts/analysis/data_inventory_report.json"
        ],
        "present_artifacts": [
          "artifacts/runtime/source_link.json"
        ]
      },
      "phase": "diagnose",
      "tools": [
        "audit_data_inventory"
      ],
      "summary": "Audit the current Data directory against the 6-region task definition before diagnosis.",
      "followup_phase": "diagnose"
    },
    {
      "name": "diagnose source project",
      "when": {
        "missing_artifacts": [
          "artifacts/analysis/acl26_adi_diagnosis.json"
        ],
        "present_artifacts": [
          "artifacts/runtime/source_link.json",
          "artifacts/analysis/data_inventory_report.json"
        ]
      },
      "phase": "diagnose",
      "tools": [
        "diagnose_acl26_adi"
      ],
      "summary": "Inspect ACL26_ADI and freeze the ADI-only interpretation before execution.",
      "followup_phase": "propose"
    },
    {
      "name": "verify runtime before execution",
      "when": {
        "missing_artifacts": [
          "artifacts/runtime/runtime_report.json"
        ],
        "present_artifacts": [
          "artifacts/analysis/acl26_adi_diagnosis.json"
        ]
      },
      "phase": "propose",
      "tools": [
        "verify_runtime"
      ],
      "summary": "Confirm the AutoOpt environment is ready before running any ADI baseline.",
      "followup_phase": "execute"
    },
    {
      "name": "verify ecoschool formal readiness",
      "when": {
        "missing_artifacts": [
          "artifacts/runtime/eco_ready_acoustic_v1.json"
        ],
        "present_artifacts": [
          "artifacts/runtime/runtime_report.json"
        ]
      },
      "phase": "execute",
      "tools": [
        "verify_ecoschool_formal_ready"
      ],
      "summary": "Bootstrap gpu-worker-01 and verify that the formal training data, environment, and object storage access are ready.",
      "followup_phase": "execute"
    },
    {
      "name": "run acoustic v1 on ecoschool",
      "when": {
        "missing_artifacts": [
          "artifacts/runtime/train_manifest_acoustic_v1.json"
        ],
        "present_artifacts": [
          "artifacts/runtime/eco_ready_acoustic_v1.json"
        ]
      },
      "phase": "execute",
      "tools": [
        "train_acl26_acoustic_v1"
      ],
      "summary": "Submit the first serious acoustic-only baseline to gpu-worker-01 via tmux-backed remote execution.",
      "followup_phase": "evaluate"
    },
    {
      "name": "evaluate acoustic v1 on formal dev",
      "when": {
        "missing_artifacts": [
          "artifacts/metrics/eval_formal_dev_acoustic_v1.json"
        ],
        "present_artifacts": [
          "artifacts/runtime/train_manifest_acoustic_v1.json"
        ]
      },
      "phase": "evaluate",
      "tools": [
        "evaluate_acl26_formal_dev"
      ],
      "summary": "Evaluate the current acoustic-only baseline on the frozen formal dev suite.",
      "followup_phase": "evaluate"
    },
    {
      "name": "evaluate acoustic v1 on local gold",
      "when": {
        "missing_artifacts": [
          "artifacts/metrics/eval_local_gold_acoustic_v1.json"
        ],
        "present_artifacts": [
          "artifacts/metrics/eval_formal_dev_acoustic_v1.json"
        ]
      },
      "phase": "evaluate",
      "tools": [
        "evaluate_acl26_local_gold"
      ],
      "summary": "Run the Local gold final gate after the formal dev benchmark passes through the same acoustic baseline checkpoint.",
      "followup_phase": "reflect"
    },
    {
      "name": "reflect on acoustic v1",
      "when": {
        "missing_artifacts": [
          "artifacts/analysis/reflection_1.json"
        ],
        "present_artifacts": [
          "artifacts/metrics/eval_local_gold_acoustic_v1.json"
        ]
      },
      "phase": "reflect",
      "tools": [
        "reflect_acl26_acoustic_v1"
      ],
      "summary": "Turn the first serious acoustic-only baseline outcome into concrete next steps for the next ADI optimization round.",
      "followup_phase": "done"
    },
    {
      "name": "mark adaptation pilot ready",
      "when": {
        "present_artifacts": [
          "artifacts/analysis/reflection_1.json"
        ]
      },
      "phase": "done",
      "tools": [],
      "summary": "ACL26_OPT completed diagnosis, formal acoustic-only baseline training, formal dev evaluation, Local gold gating, and reflection."
    }
  ]
}
